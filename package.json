{
  "name": "cloudops",
  "version": "1.0.0",
  "description": "CloudOps - Production Observability & SRE Platform",
  "scripts": {
    "up": "npx concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "start": "npm run up",
    "dev": "npm run up",
    "down": "npx kill-port 5000 5173",
    "stop": "npm run down",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "build": "npm run build --prefix client"
  },
  "keywords": [
    "observability",
    "sre",
    "monitoring",
    "kubernetes",
    "aiops",
    "grafana",
    "prometheus"
  ],
  "author": "Shivansh",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "kill-port": "^2.0.1"
  }
}
